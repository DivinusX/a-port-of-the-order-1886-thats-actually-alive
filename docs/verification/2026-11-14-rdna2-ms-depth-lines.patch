diff --git a/gpu/shadps4/video_core/amdgpu/ps4_msaa.h b/gpu/shadps4/video_core/amdgpu/ps4_msaa.h
index 5e47a19..191be91 100644
--- a/gpu/shadps4/video_core/amdgpu/ps4_msaa.h
+++ b/gpu/shadps4/video_core/amdgpu/ps4_msaa.h
@@ -1,8 +1,26 @@
 // SPDX-License-Identifier: GPL-2.0-or-later
+// Guest multisampled images created and sampled as single-sampled ones, on drivers that cannot
+// read a compressed multisampled depth buffer from a shader.
+//
+// The native PS4 baseline keeps the guest's sample counts, and every driver known to read the
+// game's multisampled depth correctly keeps them. AMD's proprietary driver does not on RDNA2
+// (RX 6600 family): a shader fetch of a multisampled depth buffer (texelFetch on a
+// sampler2DMS) returns zero in the lower half of many 8x8 pixel tiles, the ones with little
+// depth variation, which looks like compressed depth read without being expanded. Lighting
+// that uses that depth then shows black lines 4 pixels tall every 8 render rows, only where
+// light falls (issue #4 of the DivinusX port; gow3_pc #65 found and fixed the same fault on
+// the same emulation core). Sampling in the General layout does not help, so on that driver
+// the images lose their extra samples instead: the depth test and the shaders then use the
+// same single-sampled buffer. Guest sizes and addresses still use the real sample count
+// (GuestNumSamples).
+//
+// The default per driver is ps4_msaa_default.h; ORDER1886_NO_MSAA=0 or 1 decides otherwise
+// (vk_instance.cpp).
 #pragma once
 #include <atomic>
 namespace AmdGpu {
-// Preserve the guest's multisampling semantics in the native PS4 baseline.
 inline std::atomic<bool> no_msaa{false};
-inline bool NoMsaa() { return false; }
+inline bool NoMsaa() {
+    return no_msaa.load(std::memory_order_relaxed);
+}
 } // namespace AmdGpu
diff --git a/gpu/shadps4/video_core/amdgpu/ps4_msaa_default.h b/gpu/shadps4/video_core/amdgpu/ps4_msaa_default.h
new file mode 100644
index 0000000..bf8dc06
--- /dev/null
+++ b/gpu/shadps4/video_core/amdgpu/ps4_msaa_default.h
@@ -0,0 +1,22 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// The Vulkan drivers where the game's multisampled images are created single-sampled unless
+// ORDER1886_NO_MSAA says otherwise (ps4_msaa.h). Plain C, so tests and tools can include it.
+//
+// AMD's proprietary driver: the RX 6600 family reads a multisampled depth buffer wrong from a
+// shader and the lighting shows black lines (DivinusX port #4, gow3_pc #65, where five RX
+// 6600/6650 XT owners confirmed the fix). NVIDIA, RADV, AMDVLK, Mesa ANV and MoltenVK read it
+// correctly as far as known and keep the game's multisampling: the native baseline.
+#pragma once
+
+#include <vulkan/vulkan_core.h>
+
+static inline int order1886_no_msaa_default(VkDriverId driver) {
+    return driver == VK_DRIVER_ID_AMD_PROPRIETARY;
+}
+
+/* "0" or "1" in ORDER1886_NO_MSAA wins; anything else (or unset) uses the driver default. */
+static inline int order1886_no_msaa(VkDriverId driver, const char* env) {
+    if (env && (env[0] == '0' || env[0] == '1') && env[1] == '\0')
+        return env[0] == '1';
+    return order1886_no_msaa_default(driver);
+}
