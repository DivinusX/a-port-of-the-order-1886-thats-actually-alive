 /* 1 while the in-game settings menu is open: the game's pad input is held neutral. */
 int ps4gpu_overlay_captures_input(void);
 /* Snapshot of window-thread mouse-to-stick input; no SDL calls on the guest thread. */
diff --git a/gpu/shadps4/video_core/renderer_vulkan/vk_presenter.cpp b/gpu/shadps4/video_core/renderer_vulkan/vk_presenter.cpp
index 8ef2d94..f2b3196 100644
